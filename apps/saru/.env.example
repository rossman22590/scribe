# Get your OpenRouter API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=****

# App name shown on the OpenRouter dashboard (required for localhost dev)
# OPENROUTER_APP_TITLE=Scribe
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional OpenRouter model overrides for internal helper tasks
# OPENROUTER_TITLE_MODEL=openai/gpt-oss-20b
# OPENROUTER_ARTIFACT_MODEL=anthropic/claude-3.5-haiku

DATABASE_URL="postgresql://user:password@localhost:5432/cursorforwriting_db"
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=123456789
TAVILY_API_KEY=...

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1364565597974954014/U9epDQwldNhgeFPT6ZktqcR9pBbwuJLf2SgAkeRiE9nnVDfhPqMA_8LO7semIMalVOS1

DB_LOG_QUERIES=true # To log drizzle queries

# Stripe billing (both flags must be "true" to enable)
STRIPE_ENABLED=false
NEXT_PUBLIC_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...
STRIPE_ULTRA_MONTHLY_PRICE_ID=price_...
STRIPE_ULTRA_YEARLY_PRICE_ID=price_...

# Credits: 1 credit = $0.01 of OpenRouter API cost
# CREDIT_USD_VALUE=0.01
# Monthly API budgets (USD) → credits = USD / CREDIT_USD_VALUE
# CREDITS_FREE_USD_MONTHLY=1
# CREDITS_PREMIUM_USD_MONTHLY=10
# CREDITS_ULTRA_USD_MONTHLY=30
# CREDIT_MIN_PER_REQUEST=1

# OpenRouter USD per 1M tokens (list prices; override if OR changes rates)
# OR_PRICE_HAIKU_INPUT_PER_M=0.8
# OR_PRICE_HAIKU_OUTPUT_PER_M=4
# OR_PRICE_SONNET_INPUT_PER_M=3
# OR_PRICE_SONNET_OUTPUT_PER_M=15
# OR_PRICE_GPT55_INPUT_PER_M=5
# OR_PRICE_GPT55_OUTPUT_PER_M=30
